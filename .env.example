# Vercel Upstash KV (created automatically when you connect Storage)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Also supported if you use classic Upstash Redis env names
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Long random string for signing login cookies (required in production)
SESSION_SECRET=replace-with-a-long-random-secret
